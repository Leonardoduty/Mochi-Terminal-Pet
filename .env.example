# AI Provider Configuration (Optional: groq, openrouter, nvidia, openai)
# If not specified, Mochi will auto-detect the provider based on your available API key.
AI_PROVIDER=groq

# 1. Groq Cloud (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
# Optional model override (Default: openai/gpt-oss-120b)
# Models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.6-27b
# GROQ_MODEL=openai/gpt-oss-120b

# 2. OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional model override (Default: openrouter/free)
# Models: openrouter/free, meta-llama/llama-3.3-70b-instruct:free, deepseek/deepseek-chat:free
# OPENROUTER_MODEL=openrouter/free

# 3. NVIDIA NIM (https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here
# NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# 4. OpenAI (https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
